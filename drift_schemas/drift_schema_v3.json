    {
      "name": "spots",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spots\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"latitude\" REAL NOT NULL, \"longitude\" REAL NOT NULL, \"notes\" TEXT NULL, \"is_favorite\" INTEGER NOT NULL DEFAULT 0 CHECK (\"is_favorite\" IN (0, 1)), \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "spot_photos",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"spot_photos\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"spot_id\" INTEGER NOT NULL REFERENCES spots (id) ON DELETE CASCADE, \"image_bytes\" BLOB NOT NULL, \"thumbnail_bytes\" BLOB NOT NULL, \"width\" INTEGER NOT NULL, \"height\" INTEGER NOT NULL);"
        }
      ]
    },
    {
      "name": "drones",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"drones\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"type\" TEXT NOT NULL DEFAULT 'quadcopter', \"takeoff_weight_grams\" REAL NULL, \"max_speed_meters_per_second\" REAL NULL, \"notes\" TEXT NULL, \"created_at\" INTEGER NOT NULL DEFAULT (CAST(strftime('%s', CURRENT_TIMESTAMP) AS INTEGER)));"
        }
      ]
    },
    {
      "name": "batteries",
      "sql": [
        {
          "dialect": "sqlite",
          "sql": "CREATE TABLE IF NOT EXISTS \"batteries\" (\"id\" INTEGER NOT NULL PRIMARY KEY AUTOINCREMENT, \"name\" TEXT NOT NULL, \"chemistry\" TEXT NOT NULL DEFAULT 'LiPo', \"cell_count\" INTEGER NOT NULL, \"capacity_mah\" INTEGER NOT NULL, \"weight_grams\" REAL NULL, \"cycle_count\" INTEGER NOT NULL DEFAULT 0, \"notes\" TEXT NULL);"
        }
      ]
    },
