  "commonBewoelkungModellbedeckungKeineGemessenencfb37c6a": "Cloud: 0–100% model cover, no measured 3D clouds. Temperature: °C at 2 m height. All visible grids use the same forecast time.",
  "@commonBewoelkungModellbedeckungKeineGemessenencfb37c6a": {
